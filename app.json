{
  "expo": {
    "name": "Orbit",
    "slug": "todolist-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbit.productivity",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B4FEA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.orbit.productivity",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D14"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B5BF6"
        }
      ],
      "expo-asset",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ]
    ],
    "scheme": "orbit",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "eas": {
        "projectId": "ef149b57-d4d4-48f4-a43e-c26b90ec682e"
      }
    },
    "owner": "tatight"
  }
}
